---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
---

<Layout
	title="Page Not Found | White Rose Home Improvements"
	description="The page you're looking for can't be found. Explore White Rose Home Improvements' services across Leeds, York and Yorkshire, or get in touch."
	noindex
>
	<Section bg="dark">
		<div class="not-found reveal">
			<Eyebrow text="404 Error" />
			<h1>Page Not Found</h1>
			<p class="text-secondary">
				Sorry, we couldn't find the page you were looking for. It may have been moved or no
				longer exists.
			</p>
			<div class="not-found-actions">
				<Button href="/" variant="primary" class="magnetic">Back To Homepage</Button>
				<Button href="/services" variant="secondary-dark" class="magnetic">View Our Services</Button>
				<Button href="/contact" variant="secondary-dark" class="magnetic">Contact Us</Button>
			</div>
		</div>
	</Section>
</Layout>

<style>
	.not-found {
		max-width: 620px;
		margin: 0 auto;
		text-align: center;
		padding: 60px 0;
	}

	.not-found h1 {
		margin-top: 18px;
		color: var(--color-white);
	}

	.not-found p {
		margin-top: 22px;
	}

	.not-found-actions {
		margin-top: 40px;
		display: flex;
		justify-content: center;
		gap: 16px;
		flex-wrap: wrap;
	}
</style>
