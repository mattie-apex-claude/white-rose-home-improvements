---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { areas, getArea } from '../../data/areas';
import { services } from '../../data/services';

export function getStaticPaths() {
	return areas.map((area) => ({ params: { area: area.slug } }));
}

const { area: slug } = Astro.params;
const area = getArea(slug as string);

const heroImages = [
	'/Images/Services/Paving : Patios/Raj Green : mixed sandstone with a circular patio feature.png',
	'/Images/Services/Fences/Timber and Concrete Posts + Boards.png',
	'/Images/Services/Turfing /Turfing 1 .png',
	'/Images/Services/Decking/Decking Project 1/Decking 2.jpg',
];
const heroImage = heroImages[areas.findIndex((a) => a.slug === area.slug) % heroImages.length];

const nearbyAreas = area.nearby.map((slug) => getArea(slug));

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: area.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};
---

<Layout title={area.metaTitle} description={area.metaDescription} ogImage={heroImage}>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<Hero
		image={heroImage}
		eyebrow="Areas We Cover"
		title={area.heading}
		subtitle={area.intro}
		primaryCta={{ text: 'Get Your Free Quote', href: '/contact' }}
		size="tall"
	/>

	<Section bg="off-white">
		<div class="area-grid">
			<div class="area-content reveal">
				<Eyebrow text="Local Coverage" />
				<h2>Serving {area.name} & The Surrounding Area</h2>
				<p class="text-secondary">{area.coverageNote}</p>

				<h3>Services Available In {area.name}</h3>
				<ul class="area-services">
					{
						services.map((service) => (
							<li>
								<a href={`/services/${service.slug}`}>{service.title}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="area-side reveal">
				<h4>Nearby Areas We Also Cover</h4>
				<ul class="area-nearby">
					{
						nearbyAreas.map((nearby) => (
							<li>
								<a href={`/areas/${nearby.slug}`}>{nearby.name}</a>
							</li>
						))
					}
				</ul>
				<a href="/areas" class="area-all-link">View All Areas We Cover &rarr;</a>
			</div>
		</div>
	</Section>

	<FAQSection heading={`${area.name} Landscaping FAQs`} items={area.faqs} bg="white" />

	<CTASection
		heading={`Ready To Start Your ${area.name} Project?`}
		subtitle="Tell us about your garden and we'll help bring it to life, from first design through to finished build."
		cta={{ text: 'Contact Us', href: '/contact' }}
		image="/Images/Services/Turfing /Turfing 1 .png"
	/>
</Layout>

<style>
	.area-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 64px;
		align-items: start;
	}

	.area-content h2 {
		margin-top: 18px;
	}

	.area-content p {
		margin-top: 20px;
		max-width: 560px;
	}

	.area-content h3 {
		margin-top: 44px;
		font-size: var(--h4-size);
	}

	.area-services {
		list-style: none;
		margin: 22px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 24px;
	}

	.area-services li {
		padding: 12px 0;
		border-top: 1px solid rgba(11, 11, 11, 0.08);
	}

	.area-services li:nth-child(1),
	.area-services li:nth-child(2) {
		border-top: none;
	}

	.area-services a {
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-primary);
		transition: color var(--transition);
	}

	.area-services a:hover {
		color: var(--color-gold-dark);
	}

	.area-side {
		background: var(--color-white);
		border-radius: var(--radius);
		padding: 36px;
		border: 1px solid rgba(11, 11, 11, 0.06);
	}

	.area-nearby {
		list-style: none;
		margin: 18px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.area-nearby a {
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-secondary);
		transition: color var(--transition);
	}

	.area-nearby a:hover {
		color: var(--color-gold-dark);
	}

	.area-all-link {
		display: inline-block;
		margin-top: 24px;
		font-size: 14px;
		font-weight: 700;
		color: var(--color-gold-dark);
		border-bottom: 1.5px solid rgba(213, 160, 24, 0.4);
		padding-bottom: 2px;
	}

	@media (max-width: 900px) {
		.area-grid {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.area-services {
			grid-template-columns: 1fr;
		}

		.area-services li:nth-child(2) {
			border-top: 1px solid rgba(11, 11, 11, 0.08);
		}
	}
</style>
