---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	title = 'White Rose Home Improvements | Premium Outdoor Living, Yorkshire',
	description = 'White Rose Home Improvements creates premium fencing, paving, decking, garden rooms and outdoor living spaces across Yorkshire.',
	ogImage = '/Images/Services/Paving : Patios/Raj Green : mixed sandstone with a circular patio feature.png',
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(encodeURI(ogImage), Astro.site);

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'HomeAndConstructionBusiness',
	name: business.name,
	url: business.url,
	image: new URL(encodeURI(business.logo), Astro.site).toString(),
	telephone: business.telephone,
	email: business.email,
	description: business.description,
	areaServed: business.areaServed.map((place) => ({ '@type': 'Place', name: place })),
	sameAs: business.sameAs,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

		<ClientRouter />
	</head>
	<body>
		<div class="scroll-progress" id="scroll-progress"></div>

		<div class="intro-overlay" id="intro-overlay" aria-hidden="true">
			<img src={encodeURI('/Images/Logo/Logo - no background .jpg')} alt="" width="64" height="64" />
		</div>

		<Header />
		<slot />
		<Footer />

		<script>
			function initReveals() {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('in-view');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15 }
				);

				document
					.querySelectorAll('.reveal, .reveal-scale, .reveal-mask, .reveal-stagger-item')
					.forEach((el) => {
						if (!el.classList.contains('in-view')) observer.observe(el);
					});
			}

			function initScrollProgress() {
				const bar = document.getElementById('scroll-progress');
				if (!bar) return;

				const update = () => {
					const scrollTop = window.scrollY;
					const height = document.documentElement.scrollHeight - window.innerHeight;
					const progress = height > 0 ? Math.min(scrollTop / height, 1) : 0;
					bar.style.transform = `scaleX(${progress})`;
				};

				update();
				window.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update);
			}

			function initIntro() {
				const overlay = document.getElementById('intro-overlay');
				if (!overlay) return;

				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const alreadyShown = sessionStorage.getItem('wr-intro-shown');

				if (alreadyShown || reduceMotion) {
					overlay.remove();
					return;
				}

				sessionStorage.setItem('wr-intro-shown', 'true');
				document.body.classList.add('intro-active');
				requestAnimationFrame(() => overlay.classList.add('intro-in'));

				window.setTimeout(() => {
					overlay.classList.add('intro-out');
					document.body.classList.remove('intro-active');
				}, 700);

				window.setTimeout(() => overlay.remove(), 1100);
			}

			function initPage() {
				initReveals();
				initScrollProgress();
			}

			initIntro();
			initPage();
			document.addEventListener('astro:page-load', initPage);
		</script>

		<style>
			.scroll-progress {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 3px;
				background: var(--color-gold);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 100ms linear;
				z-index: 300;
				pointer-events: none;
			}

			.intro-overlay {
				position: fixed;
				inset: 0;
				z-index: 400;
				pointer-events: none;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--color-black);
				opacity: 0;
				transition:
					opacity 400ms var(--ease-premium),
					visibility 400ms var(--ease-premium);
			}

			.intro-overlay img {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				opacity: 0;
				transform: scale(0.9);
				transition:
					opacity 500ms var(--ease-premium),
					transform 500ms var(--ease-premium);
			}

			.intro-overlay.intro-in {
				opacity: 1;
			}

			.intro-overlay.intro-in img {
				opacity: 1;
				transform: scale(1);
			}

			.intro-overlay.intro-out {
				opacity: 0;
				pointer-events: none;
			}

			body.intro-active {
				overflow: hidden;
			}

			@media (prefers-reduced-motion: reduce) {
				.intro-overlay,
				.intro-overlay img,
				.scroll-progress {
					transition: none;
				}
			}
		</style>
	</body>
</html>
