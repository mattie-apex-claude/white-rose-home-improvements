---
import { services } from '../data/services';
import ContactMethods from './ContactMethods.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-top">
		<div class="footer-brand">
			<a href="/" class="footer-logo">
				<img
					src={encodeURI('/Images/Logo/Logo - no background .jpg')}
					alt="White Rose Home Improvements"
					width="56"
					height="56"
				/>
			</a>
			<p class="text-secondary footer-tagline">
				Premium outdoor living, built with craft and care across Yorkshire.
			</p>
		</div>

		<div class="footer-col">
			<h4 class="footer-heading">Navigate</h4>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/areas">Areas We Cover</a></li>
				<li><a href="/gallery">Gallery</a></li>
				<li><a href="/contact">Contact Us</a></li>
			</ul>
		</div>

		<div class="footer-col">
			<h4 class="footer-heading">Services</h4>
			<ul>
				{services.map((service) => <li><a href={`/services/${service.slug}`}>{service.title}</a></li>)}
			</ul>
		</div>

		<div class="footer-col">
			<h4 class="footer-heading">Get in touch</h4>
			<ContactMethods class="footer-contact" />
			<p class="footer-area">Based in Tadcaster &amp; Boston Spa, serving West &amp; North Yorkshire</p>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} White Rose Home Improvements. All rights reserved.</p>
		<span class="section-label" style="--section-label-margin: 0;">Est. in Yorkshire</span>
	</div>

	<div class="container footer-credit">
		<p>
			Website and Marketing by
			<a href="https://apexflowio.com/" target="_blank" rel="noopener noreferrer">ApexFlow</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-charcoal);
		color: var(--color-text-muted);
		padding: 90px 0 0;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1.6fr 0.8fr 1fr 1.1fr;
		gap: 48px;
		padding-bottom: 70px;
		border-bottom: 1px solid rgba(247, 245, 240, 0.12);
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 20px;
	}

	.footer-logo img {
		width: 52px;
		height: 52px;
		object-fit: contain;
		border-radius: 50%;
		background: var(--color-white);
	}

	.footer-logo span {
		font-family: var(--font-heading);
		font-size: 20px;
		color: var(--color-white);
		line-height: 1.2;
	}

	.footer-logo em {
		display: block;
		font-style: normal;
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-gold);
	}

	.footer-tagline {
		max-width: 320px;
		color: var(--color-text-muted);
	}

	.footer-heading {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-white);
		margin-bottom: 22px;
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 13px;
	}

	.footer-col a {
		font-size: 15px;
		color: var(--color-text-muted);
		transition: color var(--transition);
	}

	.footer-col a:hover {
		color: var(--color-gold);
	}

	.footer-contact li {
		font-size: 15px;
	}

	.footer-area {
		margin-top: 22px;
		font-size: 14px;
		color: var(--color-text-muted);
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 0;
		font-size: 13px;
		color: rgba(209, 209, 209, 0.6);
	}

	.footer-credit {
		padding: 0 0 24px;
		text-align: center;
		border-top: 1px solid rgba(247, 245, 240, 0.08);
	}

	.footer-credit p {
		padding-top: 18px;
		font-size: 12px;
		color: rgba(209, 209, 209, 0.45);
	}

	.footer-credit a {
		color: rgba(209, 209, 209, 0.65);
		transition: color var(--transition);
	}

	.footer-credit a:hover {
		color: var(--color-gold);
	}

	@media (max-width: 900px) {
		.footer-top {
			grid-template-columns: 1fr 1fr;
			row-gap: 44px;
		}
	}

	@media (max-width: 600px) {
		.footer-top {
			grid-template-columns: 1fr;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 14px;
			align-items: flex-start;
		}
	}
</style>
