---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const methods = [
	{
		key: 'phone',
		label: '+44 7476 945466',
		href: 'tel:+447476945466',
	},
	{
		key: 'email',
		label: 'info@whiterosehomeimprovements.com',
		href: 'mailto:info@whiterosehomeimprovements.com',
	},
	{
		key: 'facebook',
		label: 'Facebook',
		href: 'https://www.facebook.com/profile.php?id=61583236381509',
		external: true,
	},
	{
		key: 'instagram',
		label: 'Instagram',
		href: 'https://www.instagram.com/whiterosehomeimprovements/',
		external: true,
	},
];
---

<ul class={`contact-methods ${className}`}>
	{
		methods.map((method) => (
			<li>
				<a
					href={method.href}
					target={method.external ? '_blank' : undefined}
					rel={method.external ? 'noopener noreferrer' : undefined}
				>
					<span class="contact-icon" aria-hidden="true">
						{method.key === 'phone' && (
							<svg viewBox="0 0 24 24" fill="none">
								<path
									d="M4.5 4.5c0-.6.4-1 1-1h2.6c.5 0 .9.3 1 .8l.8 3.6c.1.5-.1 1-.5 1.3l-1.6 1.2a13.5 13.5 0 0 0 6.3 6.3l1.2-1.6c.3-.4.8-.6 1.3-.5l3.6.8c.5.1.8.5.8 1v2.6c0 .6-.4 1-1 1h-1.5C10.6 20 4 13.4 4 5.5V4.5Z"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
						{method.key === 'email' && (
							<svg viewBox="0 0 24 24" fill="none">
								<rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.6" />
								<path
									d="m4.5 6.5 7.5 6 7.5-6"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
						{method.key === 'facebook' && (
							<svg viewBox="0 0 24 24" fill="none">
								<path
									d="M14.5 21v-7.5h2.5l.5-3h-3V8.4c0-.9.3-1.5 1.6-1.5H17.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.3H9v3h2.4V21h3.1Z"
									fill="currentColor"
								/>
							</svg>
						)}
						{method.key === 'instagram' && (
							<svg viewBox="0 0 24 24" fill="none">
								<rect x="4" y="4" width="16" height="16" rx="4.5" stroke="currentColor" stroke-width="1.6" />
								<circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6" />
								<circle cx="16.8" cy="7.2" r="1" fill="currentColor" />
							</svg>
						)}
					</span>
					<span class="contact-label">{method.label}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.contact-methods {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.contact-methods a {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		color: inherit;
		font-size: 15px;
		font-weight: 600;
		transition: color var(--transition);
	}

	.contact-methods a:hover {
		color: var(--color-gold);
	}

	.contact-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		border-radius: 50%;
		border: 1.5px solid var(--color-gold);
		color: var(--color-gold);
	}

	.contact-icon svg {
		width: 18px;
		height: 18px;
	}
</style>
