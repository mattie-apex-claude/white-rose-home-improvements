---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
	eyebrow?: string;
	heading: string;
	images: string[];
	bg?: 'off-white' | 'white' | 'dark';
	uniform?: boolean;
}

const { eyebrow = 'Gallery', heading, images, bg = 'white', uniform = false } = Astro.props;
---

<Section bg={bg}>
	<div class="gallery-heading reveal">
		<Eyebrow text={eyebrow} />
		<h2>{heading}</h2>
	</div>
	<div class="gallery-grid reveal">
		{
			images.map((image, index) => (
				<div class={`gallery-item ${!uniform && index % 3 === 1 ? 'gallery-item-tall' : ''}`}>
					<img src={encodeURI(image)} alt="" loading="lazy" />
				</div>
			))
		}
	</div>
</Section>

<style>
	.gallery-heading {
		max-width: 600px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.gallery-heading h2 {
		margin-top: 18px;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.gallery-item {
		overflow: hidden;
		border-radius: 4px;
		aspect-ratio: 4 / 3;
	}

	.gallery-item-tall {
		aspect-ratio: 3 / 4;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.gallery-item:hover img {
		transform: scale(1.06);
	}

	@media (max-width: 900px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
