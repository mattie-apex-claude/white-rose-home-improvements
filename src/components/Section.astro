---
interface Props {
	bg?: 'off-white' | 'white' | 'dark';
	class?: string;
	id?: string;
}

const { bg = 'off-white', class: className = '', id } = Astro.props;
---

<section class={`section section-${bg} ${className}`} id={id}>
	<div class="container">
		<slot />
	</div>
</section>

<style>
	.section {
		padding: var(--section-padding-desktop) 0;
	}

	.section-off-white {
		background: var(--color-off-white);
		color: var(--color-text-primary);
	}

	.section-white {
		background: var(--color-white);
		color: var(--color-text-primary);
	}

	.section-dark {
		background: var(--color-black);
		color: var(--color-text-light);
	}

	.section-dark :global(h1),
	.section-dark :global(h2),
	.section-dark :global(h3),
	.section-dark :global(h4) {
		color: var(--color-white);
	}

	.section-dark :global(.text-secondary) {
		color: var(--color-text-muted);
	}

	@media (max-width: 600px) {
		.section {
			padding: var(--section-padding-mobile) 0;
		}
	}
</style>
