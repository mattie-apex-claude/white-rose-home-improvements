---
import Button from './Button.astro';

interface CTA {
	text: string;
	href: string;
}

interface Props {
	image: string;
	eyebrow?: string;
	heading: string;
	text?: string;
	cta?: CTA;
	height?: 'tall' | 'medium';
}

const { image, eyebrow, heading, text, cta, height = 'medium' } = Astro.props;
---

<section class={`banner banner-${height}`}>
	<img class="banner-image" src={encodeURI(image)} alt="" loading="lazy" />
	<div class="banner-overlay"></div>
	<div class="container banner-content">
		{eyebrow && <span class="section-label">{eyebrow}</span>}
		<h2>{heading}</h2>
		{text && <p class="banner-text text-secondary">{text}</p>}
		{
			cta && (
				<div class="banner-cta">
					<Button href={cta.href} variant="secondary-dark">
						{cta.text}
					</Button>
				</div>
			)
		}
	</div>
</section>

<style>
	.banner {
		position: relative;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.banner-medium {
		min-height: 55vh;
	}

	.banner-tall {
		min-height: 75vh;
	}

	.banner-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.banner-overlay {
		position: absolute;
		inset: 0;
		background: rgba(11, 11, 11, 0.62);
	}

	.banner-content {
		position: relative;
		z-index: 1;
		max-width: 620px;
		padding: 70px 32px;
	}

	.banner-content .section-label {
		margin-bottom: 18px;
	}

	.banner-content h2 {
		color: var(--color-white);
	}

	.banner-text {
		margin-top: 20px;
		color: var(--color-text-muted);
	}

	.banner-cta {
		margin-top: 32px;
	}
</style>
