---
import Button from './Button.astro';

interface CTA {
	text: string;
	href: string;
}

interface Props {
	image: string;
	eyebrow?: string;
	title: string;
	subtitle?: string;
	primaryCta?: CTA;
	secondaryCta?: CTA;
	size?: 'full' | 'tall';
}

const { image, eyebrow, title, subtitle, primaryCta, secondaryCta, size = 'full' } = Astro.props;
---

<section class={`hero hero-${size}`} id="hero-parallax">
	<img class="hero-image" src={encodeURI(image)} alt="" fetchpriority="high" />
	<div class="hero-overlay"></div>
	<div class="container hero-content">
		{eyebrow && <span class="section-label hero-label hero-anim" style="animation-delay: 150ms">{eyebrow}</span>}
		<h1 class="hero-anim" style="animation-delay: 300ms" set:html={title} />
		{subtitle && <p class="hero-subtitle hero-anim" style="animation-delay: 480ms">{subtitle}</p>}
		{
			(primaryCta || secondaryCta) && (
				<div class="hero-ctas hero-anim" style="animation-delay: 640ms">
					{primaryCta && (
						<Button href={primaryCta.href} variant="primary" class="magnetic">
							{primaryCta.text}
						</Button>
					)}
					{secondaryCta && (
						<Button href={secondaryCta.href} variant="secondary-dark" class="magnetic">
							{secondaryCta.text}
						</Button>
					)}
				</div>
			)
		}
	</div>
</section>

<script>
	let parallaxBound = false;

	function updateHeroParallax() {
		const hero = document.getElementById('hero-parallax');
		const image = hero?.querySelector<HTMLImageElement>('.hero-image');
		if (!hero || !image) return;

		const rect = hero.getBoundingClientRect();
		if (rect.bottom > 0 && rect.top < window.innerHeight) {
			const offset = Math.max(-40, Math.min(40, rect.top * 0.06));
			image.style.transform = `translateY(${offset}px) scale(1.045)`;
		}
	}

	function initHeroParallax() {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const coarsePointer = window.matchMedia('(pointer: coarse)').matches;

		if (!parallaxBound && !reduceMotion && !coarsePointer) {
			let ticking = false;
			window.addEventListener(
				'scroll',
				() => {
					if (!ticking) {
						window.requestAnimationFrame(() => {
							updateHeroParallax();
							ticking = false;
						});
						ticking = true;
					}
				},
				{ passive: true }
			);
			parallaxBound = true;
		}

		updateHeroParallax();
	}

	initHeroParallax();
	document.addEventListener('astro:page-load', initHeroParallax);
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
	}

	.hero-full {
		min-height: calc(100vh - 88px);
	}

	.hero-tall {
		min-height: 62vh;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: hero-reveal 1.6s var(--ease-premium) forwards;
		will-change: transform;
	}

	@keyframes hero-reveal {
		from {
			opacity: 0;
			transform: scale(1.1);
		}
		to {
			opacity: 1;
			transform: scale(1.045);
		}
	}

	.hero-anim {
		opacity: 0;
		transform: translateY(18px);
		animation: hero-fade-up 800ms var(--ease-premium) both;
	}

	@keyframes hero-fade-up {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(11, 11, 11, 0.88) 0%,
			rgba(11, 11, 11, 0.45) 45%,
			rgba(11, 11, 11, 0.25) 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		padding: 90px 32px 90px;
		max-width: 900px;
	}

	.hero-label {
		margin-bottom: 22px;
		color: var(--color-gold);
	}

	.hero h1 {
		color: var(--color-white);
	}

	.hero-subtitle {
		margin-top: 22px;
		max-width: 560px;
		font-size: var(--body-size);
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.hero-ctas {
		display: flex;
		gap: 18px;
		margin-top: 40px;
		flex-wrap: wrap;
	}

	@media (max-width: 600px) {
		.hero-content {
			padding: 60px 20px 60px;
		}

		.hero-full {
			min-height: 92vh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-image {
			animation: none;
			transform: none !important;
		}

		.hero-anim {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>
